# Application
APP_NAME=Medical Report Cross-Checker
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, no trailing slash)
# Local Vite:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hosted: add your Vercel origin, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
# Or set FRONTEND_URL and it is merged into allowed origins:
# FRONTEND_URL=https://your-app.vercel.app
# Vercel preview/prod hosts are also allowed by default via:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# LLM Provider: "ollama" | "openai"
# Local demo → ollama | Hosted (Render) → openai + OPENAI_API_KEY
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (required on Render / cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Shared LLM generation controls
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# RAG
RAG_VECTOR_BACKEND=auto
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=5
CHROMA_COLLECTION_NAME=medical_reports

# Paths (relative to repo root when running uvicorn from project root)
UPLOAD_DIR=backend/uploads
CHROMA_PERSIST_DIR=backend/data/chroma
SQLITE_DB_PATH=backend/data/metadata.db

# Limits
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_REQUEST=10

# PDF extraction / OCR (Tesseract language data required for scanned pages)
PDF_MIN_TEXT_CHARS=1
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
# Optional absolute path to tessdata directory if auto-discovery fails
TESSDATA_PATH=

# Lab trend AI explanations
LAB_AI_EXPLANATIONS_ENABLED=true
